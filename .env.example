# 复制成 .env 后按需修改。.env 不要提交、不要外传。

# 留空 = 首次启动自动生成 48 字节随机密钥并存到 ./data/jwt_secret。
# 想自己指定就填一个 >=32 字符的随机串：openssl rand -base64 48
# 一旦有用户注册，这个值不要再改，改了所有人掉线 + 云备份凭据解不开。
JWT_SECRET=

# 你的访问域名（不带协议、不带路径）。Passkey 登录必须与实际域名一致。
WEBAUTHN_RP_ID=

# 显示在系统的 Passkey 提示里
WEBAUTHN_RP_NAME=NodeWarden

# 允许的 Origin，多个用逗号分隔；一般填 https://<你的域名>
WEBAUTHN_ALLOWED_ORIGINS=

# 1 = 关闭自带网页版（只保留 API，客户端照常用）；留空 = 开启网页版
HIDE_WEB_VAULT=

# 容器端口映射：宿主只监听回环，由 Nginx / Cloudflare Tunnel 反代进来
NW_BIND_ADDR=127.0.0.1
NW_HOST_PORT=18787

# 1 = 每 5 分钟触发一次定时任务（自动云备份靠它）；0 = 关闭
NW_ENABLE_CRON=1
